/*/{Protheus.doc} Ex01Prod
/*/
User Function Ex01Prod()
    // Declaração explícita de variáveis Locais (Notação Húngara)
    Local cCodigo     := "PRD001"
    Local cNome       := "Teclado Mecânico"
    Local nPreco      := 250.00
    Local nQuantidade := 15
    Local lAtivo      := .T.

    // Impressão formatada no log do servidor (AppServer)
    ConOut("=== DADOS DO PRODUTO ===")
    ConOut("Código....: " + cCodigo)
    ConOut("Nome......: " + cNome)
    ConOut("Preço.....: R$ " + Transform(nPreco, "@E 999,999.99"))
    ConOut("Estoque...: " + cValToChar(nQuantidade) + " un.")
    ConOut("Status....: " + IIf(lAtivo, "Ativo", "Inativo"))
    ConOut("========================")

Return Nil

