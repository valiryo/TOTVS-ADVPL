/*/{Protheus.doc} Ex03Array
Exercício 3: Criação, povoamento e percorrimento de arrays multidimensionais.
/*/
User Function Ex03Array()
    // 1. Todas as variáveis Locais declaradas no TOPO da função
    Local aEstoque := {}
    Local nI       := 0

    // 2. Inserção de itens multidimensionais (aAdd)
    aAdd(aEstoque, {"PRD001", "Notebook",   4500.00, 10})
    aAdd(aEstoque, {"PRD002", "Monitor 27", 1500.00,  5})

    ConOut("=== LISTAGEM DE PRODUTOS EM MEMÓRIA ===")

    // 3. Laço For/Next do índice 1 até o tamanho do array (Len)
    For nI := 1 To Len(aEstoque)
        ConOut( aEstoque[nI][1] + " | " + ;
                aEstoque[nI][2] + " | R$ " + ;
                Transform(aEstoque[nI][3], "@E 999,999.99") + " | Qtd: " + ;
                cValToChar(aEstoque[nI][4]) )
    Next nI

    ConOut("========================================")

Return Nil

