/*/{Protheus.doc} Ex04BuscaDel
Exercício 4: Busca por chave com aScan e remoção física com aDel + aSize.
/*/
User Function Ex04BuscaDel()
    Local aEstoque := {}
    Local nPos     := 0
    Local cBusca   := "PRD001"

    // Inserção corrigida (4 colunas padronizadas por linha)
    aAdd(aEstoque, {"PRD001", "Notebook", 4500.00, 10})
    aAdd(aEstoque, {"PRD002", "Monitor",  1500.00,  5})
    aAdd(aEstoque, {"PRD003", "Teclado",   250.00, 15})

    // Busca insensível a maiúsculas/minúsculas e sem espaços extras
    nPos := aScan(aEstoque, {|x| Upper(AllTrim(x[1])) == Upper(AllTrim(cBusca)) })

    If nPos == 0
        ConOut("[ERRO] Produto " + cBusca + " não localizado.")
    Else
        ConOut("[SUCESSO] Produto encontrado na posição: " + cValToChar(nPos))
        
        // Remoção padrão ADVPL: aDel limpa/desloca, aSize redimensiona
        aDel(aEstoque, nPos)
        aSize(aEstoque, Len(aEstoque) - 1)
        
        ConOut("Nova quantidade de produtos no estoque: " + cValToChar(Len(aEstoque)))
    EndIf

Return Nil

